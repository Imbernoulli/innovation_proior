+# ---------------------------------------------------------------------------
+# str_replace anchor resolution
+#
+# `op='str_replace'` addresses code by *reproducing it verbatim*, unlike the
+# line-range ops which address it by two integers. That is only a fair contract
+# when the agent can re-read the file at will (Anthropic's text-editor tool
+# pairs `str_replace` with `view`). This harness has no `view` tool, and the
+# only rendering of the file the agent ever sees is the line-number-prefixed
+# dump in the initial prompt (base.py build_initial_prompt) plus a 3-line peek
+# after each edit. A byte-exact matcher on top of that turns a *recall* failure
+# into a rejected tool call.
+#
+# resolve_old_str() therefore walks a ladder of progressively looser matches and
+# accepts a level only when it yields exactly ONE candidate span, so an edit is
+# never silently applied to the wrong place.
+# ---------------------------------------------------------------------------
+
+# The initial prompt renders every file line as "%6d: <line>" — models routinely
+# echo that prefix back, or echo the "%6d  <line>" form used by _file_snapshot.
+_LNUM_PREFIX_RE = re.compile(r"^[ \t]{0,10}\d{1,6}[ \t]*(?:[:|][ \t]?|[ \t])")
+
+# Look-alike characters that survive a model round-trip but break byte equality.
+_UNICODE_FOLD = {
+    " ": " ", "‘": "'", "’": "'", "“": '"', "”": '"',
+    "−": "-", "–": "-", "—": "-", "×": "*", "﻿": "",
+}
+
+
+def _strip_line_numbers(s: str) -> tuple[str, int]:
+    """Remove prompt-style line-number prefixes. Returns (text, n_lines_stripped)."""
+    out, hits = [], 0
+    for ln in s.split("\n"):
+        stripped = _LNUM_PREFIX_RE.sub("", ln, count=1)
+        if stripped != ln:
+            hits += 1
+        out.append(stripped)
+    return "\n".join(out), hits
+
+
+def _fold_unicode(s: str) -> str:
+    s = s.replace("\r\n", "\n").replace("\r", "\n")
+    for a, b in _UNICODE_FOLD.items():
+        s = s.replace(a, b)
+    return s
+
+
+def _canon_line(ln: str) -> str:
+    """Whitespace-insensitive canonical form of one line."""
+    return re.sub(r"[ \t]+", " ", ln.strip())
+
+
+def _line_offsets(text: str) -> list[int]:
+    offs, pos = [0], 0
+    for ln in text.split("\n"):
+        pos += len(ln) + 1
+        offs.append(pos)
+    return offs
+
+
+def _ws_block_spans(text: str, old_str: str) -> list[tuple[int, int, int, int]]:
+    """Find `old_str` as a block of lines, ignoring indentation and internal
+    whitespace runs. Returns [(char_start, char_end, line_start, line_end)]."""
+    old_lines = old_str.split("\n")
+    lead = 0
+    while lead < len(old_lines) and not old_lines[lead].strip():
+        lead += 1
+    trail = len(old_lines)
+    while trail > lead and not old_lines[trail - 1].strip():
+        trail -= 1
+    core = [_canon_line(l) for l in old_lines[lead:trail]]
+    if not core:
+        return []
+    tl = text.split("\n")
+    tc = [_canon_line(l) for l in tl]
+    n = len(core)
+    offs = _line_offsets(text)
+    spans = []
+    for i in range(0, len(tc) - n + 1):
+        if tc[i:i + n] == core:
+            start = offs[i]
+            end = offs[i + n] - 1 if i + n <= len(tl) else len(text)
+            spans.append((start, min(end, len(text)), i + 1, i + n))
+    return spans
+
+
+def _reindent(new_str: str, old_str: str, file_block: str) -> str:
+    """Shift `new_str` by the indent delta between the agent's `old_str` and the
+    real `file_block`, so a whitespace-tolerant match does not corrupt indentation."""
+    def base_indent(s: str) -> int | None:
+        for ln in s.split("\n"):
+            if ln.strip():
+                return len(ln) - len(ln.lstrip())
+        return None
+    a, b = base_indent(old_str), base_indent(file_block)
+    if a is None or b is None or a == b:
+        return new_str
+    delta = b - a
+    out = []
+    for ln in new_str.split("\n"):
+        if not ln.strip():
+            out.append(ln)
+        elif delta > 0:
+            out.append(" " * delta + ln)
+        else:
+            cur = len(ln) - len(ln.lstrip())
+            out.append(ln[min(cur, -delta):])
+    return "\n".join(out)
+
+
+def resolve_old_str(text: str, old_str: str) -> dict:
+    """Locate the unique region of `text` designated by `old_str`.
+
+    Returns a dict with either:
+        ok=True, start, end, line_start, line_end, level, note
+    or:
+        ok=False, reason ('not_found' | 'ambiguous'), n_matches, level
+    Each level is only accepted when it produces exactly one candidate, so a
+    looser match can never silently retarget the edit.
+    """
+    if os.environ.get("MLSBENCH_STRICT_STR_REPLACE", "").strip() in ("1", "true", "yes"):
+        levels = [("exact", old_str)]
+    else:
+        cands: list[tuple[str, str]] = [("exact", old_str)]
+        lnum, hits = _strip_line_numbers(old_str)
+        if hits >= max(1, (len(old_str.split("\n")) * 2) // 3) and lnum != old_str:
+            cands.append(("line-number prefixes stripped", lnum))
+        folded = _fold_unicode(old_str)
+        if folded != old_str:
+            cands.append(("line endings / unicode normalized", folded))
+        rtrim = "\n".join(l.rstrip() for l in old_str.split("\n")).strip("\n")
+        if rtrim and rtrim != old_str:
+            cands.append(("trailing whitespace trimmed", rtrim))
+        seen, levels = set(), []
+        for name, c in cands:
+            if c and c not in seen:
+                seen.add(c)
+                levels.append((name, c))
+
+    for name, cand in levels:
+        n = text.count(cand)
+        if n == 1:
+            idx = text.index(cand)
+            end = idx + len(cand)
+            # A raw substring match can land MID-LINE when the agent's anchor is
+            # under-indented — splicing there corrupts the file (in the banked
+            # runs, mid-line matches left the file unparseable 49.6% of the time
+            # vs 24.4% for line-aligned ones). If the anchor is really a run of
+            # whole lines that differ only in indentation, snap to those lines.
+            aligned = (idx == 0 or text[idx - 1] == "\n") and (end == len(text) or text[end] == "\n")
+            if not aligned:
+                snap = _ws_block_spans(text, cand)
+                if len(snap) == 1:
+                    s, e, ls_, le_ = snap[0]
+                    return dict(ok=True, start=s, end=e, line_start=ls_, line_end=le_,
+                                level="realigned to line boundaries", matched=text[s:e],
+                                note="anchor was not aligned to line boundaries")
+            ls = text.count("\n", 0, idx) + 1
+            return dict(ok=True, start=idx, end=end, line_start=ls,
+                        line_end=ls + cand.count("\n"), level=name,
+                        matched=cand, note=("" if name == "exact" else name))
+        if n > 1:
+            return dict(ok=False, reason="ambiguous", n_matches=n, level=name)
+
+    if os.environ.get("MLSBENCH_STRICT_STR_REPLACE", "").strip() in ("1", "true", "yes"):
+        return dict(ok=False, reason="not_found", n_matches=0, level="exact")
+
+    spans = _ws_block_spans(text, old_str)
+    if len(spans) == 1:
+        s, e, ls, le = spans[0]
+        return dict(ok=True, start=s, end=e, line_start=ls, line_end=le,
+                    level="whitespace-insensitive", matched=text[s:e],
+                    note="whitespace/indentation differed")
+    if len(spans) > 1:
+        return dict(ok=False, reason="ambiguous", n_matches=len(spans),
+                    level="whitespace-insensitive")
+    return dict(ok=False, reason="not_found", n_matches=0, level="all")
+
+
+def closest_region(text: str, old_str: str, max_lines: int = 400) -> tuple[float, int, int]:
+    """Best-matching same-length line window of `text` for `old_str`.
+
+    Returns (similarity, line_start_1indexed, n_lines). Used to turn a bare
+    'not found' into an actionable error: the agent has no `view` tool, so the
+    error message is its only channel for re-reading the file.
+    """
+    import difflib
+    tl = [_canon_line(l) for l in text.split("\n")]
+    ol = [_canon_line(l) for l in old_str.split("\n")]
+    n = max(1, min(len(ol), max_lines))
+    ol = ol[:n]
+    sm = difflib.SequenceMatcher(autojunk=False)
+    # Short anchors need character-level similarity: comparing two 1-element line
+    # lists only ever yields 0.0 or 1.0, which makes the error message useless.
+    char_level = n <= 8
+    sm.set_seq2("\n".join(ol) if char_level else ol)
+    best, bi = 0.0, 0
+    for i in range(0, max(1, len(tl) - n + 1)):
+        sm.set_seq1("\n".join(tl[i:i + n]) if char_level else tl[i:i + n])
+        if sm.real_quick_ratio() <= best or sm.quick_ratio() <= best:
+            continue
+        r = sm.ratio()
+        if r > best:
+            best, bi = r, i
+    return best, bi + 1, n
+
